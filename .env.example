# SQLite file. Locally it lives in prisma/; on Railway point it at the mounted volume (file:/data/prod.db).
DATABASE_URL="file:./prisma/dev.db"

# Public URL of the site, used for Stripe redirects.
SITE_URL="http://localhost:3000"

# The single admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Long random string used to sign the admin session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Stripe. Leave empty to disable online payment (pay on site still works).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
